  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object", "required": ["email", "password"],
        "properties": { "email": { "type": "string", "format": "email" }, "password": { "type": "string" }, "role": { "type": "string" } }
      },
      "LoginRequest": {
        "type": "object", "required": ["email", "password"],
        "properties": { "email": { "type": "string" }, "password": { "type": "string" } }
      },
      "RefreshTokenRequest": {
        "type": "object", "required": ["refreshToken"],
        "properties": { "refreshToken": { "type": "string" } }
      },
      "PasswordResetRequest": {
        "type": "object", "required": ["email"],
        "properties": { "email": { "type": "string" } }
      },
      "PasswordResetConfirmRequest": {
        "type": "object", "required": ["token", "newPassword"],
        "properties": { "token": { "type": "string" }, "newPassword": { "type": "string" } }
      },
      "MfaVerifyRequest": {
        "type": "object", "required": ["secret", "code"],
        "properties": { "secret": { "type": "string" }, "code": { "type": "string" } }
      },
      "AssignRoleRequest": {
        "type": "object", "required": ["role"],
        "properties": { "role": { "type": "string", "enum": ["ATHLETE", "SCOUT", "COACH", "PARENT", "GUARDIAN", "AGENT", "ADMIN", "SUPER_ADMIN"] } }
      },
      "CreateAthleteProfileRequest": {
        "type": "object",
        "properties": { "primarySportCode": { "type": "string" }, "position": { "type": "string" }, "heightCm": { "type": "number" }, "weightKg": { "type": "number" }, "dominantFoot": { "type": "string" }, "nationality": { "type": "string" } }
      },
      "AddSportRequest": {
        "type": "object", "required": ["sportCode"],
        "properties": { "sportCode": { "type": "string" }, "position": { "type": "string" }, "isPrimary": { "type": "boolean" } }
      },
      "AddAchievementRequest": {
        "type": "object", "required": ["title", "achievedAt"],
        "properties": { "title": { "type": "string" }, "description": { "type": "string" }, "achievedAt": { "type": "string", "format": "date" } }
      },
      "CreateActivityRequest": {
        "type": "object", "required": ["templateId", "title"],
        "properties": { "templateId": { "type": "string" }, "activityTypeId": { "type": "string" }, "sportId": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" }, "activityDate": { "type": "string", "format": "date" }, "location": { "type": "string" }, "visibilityLevel": { "type": "string" }, "fieldValues": { "type": "object" } }
      },
      "InitiateUploadRequest": {
        "type": "object", "required": ["filename", "mimeType"],
        "properties": { "filename": { "type": "string" }, "mimeType": { "type": "string" }, "fileSizeBytes": { "type": "integer" } }
      },
      "GuardianRelationshipRequest": {
        "type": "object", "required": ["athleteId", "relationshipType"],
        "properties": { "athleteId": { "type": "string" }, "relationshipType": { "type": "string", "enum": ["PARENT", "LEGAL_GUARDIAN"] } }
      },
      "CreateOrganizationRequest": {
        "type": "object", "required": ["name", "type"],
        "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "country": { "type": "string" }, "description": { "type": "string" } }
      },
      "InviteMemberRequest": {
        "type": "object", "required": ["email", "memberRole"],
        "properties": { "email": { "type": "string" }, "memberRole": { "type": "string" } }
      },
      "AthleteRelationshipRequest": {
        "type": "object", "required": ["athleteId"],
        "properties": { "athleteId": { "type": "string" } }
      },
      "AssignSeatsRequest": {
        "type": "object", "required": ["seats"],
        "properties": { "seats": { "type": "integer" } }
      },
      "CreateScoutProfileRequest": {
        "type": "object", "required": ["displayName", "country"],
        "properties": { "displayName": { "type": "string" }, "bio": { "type": "string" }, "organizationName": { "type": "string" }, "country": { "type": "string" } }
      },
      "AddSpecializationRequest": {
        "type": "object",
        "properties": { "sportCode": { "type": "string" }, "position": { "type": "string" }, "ageCategory": { "type": "string" } }
      },
      "SavedSearchRequest": {
        "type": "object", "required": ["name"],
        "properties": { "name": { "type": "string" }, "filters": { "type": "object" } }
      },
      "FavouriteRequest": {
        "type": "object", "required": ["athleteId"],
        "properties": { "athleteId": { "type": "string" } }
      },
      "CreateWatchlistRequest": {
        "type": "object", "required": ["name"],
        "properties": { "name": { "type": "string" }, "description": { "type": "string" } }
      },
      "WatchlistAthleteRequest": {
        "type": "object", "required": ["athleteId"],
        "properties": { "athleteId": { "type": "string" }, "notes": { "type": "string" } }
      },
      "FollowRequest": {
        "type": "object", "required": ["athleteId"],
        "properties": { "athleteId": { "type": "string" } }
      },
      "CreateEvaluationRequest": {
        "type": "object", "required": ["athleteId"],
        "properties": { "athleteId": { "type": "string" }, "notes": { "type": "string" } }
      },
      "EvaluationScoreRequest": {
        "type": "object",
        "properties": { "criteria": { "type": "object" } }
      },
      "ScoutingNoteRequest": {
        "type": "object", "required": ["athleteId", "body"],
        "properties": { "athleteId": { "type": "string" }, "body": { "type": "string" }, "visibility": { "type": "string", "enum": ["PRIVATE", "ORGANIZATION"] } }
      },
      "ConsentRequest": {
        "type": "object", "required": ["action"],
        "properties": { "action": { "type": "string", "enum": ["GRANT", "WITHDRAW"] } }
      },
      "PurchaseSubscriptionRequest": {
        "type": "object", "required": ["planCode"],
        "properties": { "planCode": { "type": "string" }, "currency": { "type": "string", "default": "USD" } }
      },
      "SuspendUserRequest": {
        "type": "object", "required": ["reason"],
        "properties": { "reason": { "type": "string" } }
      },
      "RejectionRequest": {
        "type": "object", "required": ["reason"],
        "properties": { "reason": { "type": "string" } }
      },
      "SafeguardingReviewRequest": {
        "type": "object", "required": ["outcome"],
        "properties": { "outcome": { "type": "string", "enum": ["NO_ACTION", "WARNING_ISSUED", "ACCOUNT_SUSPENDED", "ESCALATED"] }, "notes": { "type": "string" } }
      },
      "CreateSportRequest": {
        "type": "object", "required": ["name", "code"],
        "properties": { "name": { "type": "string" }, "code": { "type": "string" }, "category": { "type": "string" } }
      },
      "AddDisciplineRequest": {
        "type": "object", "required": ["name"],
        "properties": { "name": { "type": "string" }, "code": { "type": "string" } }
      },
      "AddMetricRequest": {
        "type": "object", "required": ["name", "unit"],
        "properties": { "name": { "type": "string" }, "unit": { "type": "string" } }
      },
      "SubscriptionPlanRequest": {
        "type": "object", "required": ["code", "name", "priceUsd"],
        "properties": { "code": { "type": "string" }, "name": { "type": "string" }, "priceUsd": { "type": "number" }, "billingCycleDays": { "type": "integer" }, "entitlements": { "type": "object" } }
      },
      "CreateActivityTypeRequest": {
        "type": "object", "required": ["name", "code"],
        "properties": { "name": { "type": "string" }, "code": { "type": "string" }, "sportCode": { "type": "string" } }
      },
      "CreateActivityTemplateRequest": {
        "type": "object", "required": ["name", "activityTypeCode"],
        "properties": { "name": { "type": "string" }, "activityTypeCode": { "type": "string" }, "fields": { "type": "array", "items": { "type": "object" } } }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [{ "bearerAuth": [] }]
}
