{
  "openapi": "3.0.3",
  "info": {
    "title": "TalentHub API – Full Platform",
    "description": "Complete API reference covering all phases: authentication, athlete management, activity logging, media, discovery, scouting, notifications, safeguarding, billing, and administration.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://api.talenthub.io", "description": "Production" },
    { "url": "http://localhost:8080", "description": "Local development" }
  ],
  "tags": [
    { "name": "Authentication" },
    { "name": "Users" },
    { "name": "Athletes" },
    { "name": "Guardians" },
    { "name": "Organizations" },
    { "name": "Activity Configuration" },
    { "name": "Activities" },
    { "name": "Development" },
    { "name": "Media" },
    { "name": "Scout" },
    { "name": "Discovery" },
    { "name": "Scouting" },
    { "name": "Notifications" },
    { "name": "Safeguarding" },
    { "name": "Subscriptions" },
    { "name": "Billing" },
    { "name": "Admin – Users" },
    { "name": "Admin – Organizations" },
    { "name": "Admin – Scouts" },
    { "name": "Admin – Media" },
    { "name": "Admin – Safeguarding" },
    { "name": "Admin – Platform" },
    { "name": "Admin – Sports" },
    { "name": "Admin – Activity Schema" }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": { "summary": "Register a new user account", "tags": ["Authentication"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } } },
        "responses": { "201": { "description": "User registered" }, "409": { "description": "Email already in use" } } }
    },
    "/api/v1/auth/login": {
      "post": { "summary": "Log in and receive JWT tokens", "tags": ["Authentication"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "Tokens returned" }, "401": { "description": "Invalid credentials" } } }
    },
    "/api/v1/auth/refresh": {
      "post": { "summary": "Refresh access token", "tags": ["Authentication"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } } } },
        "responses": { "200": { "description": "New tokens" }, "401": { "description": "Refresh token invalid or expired" } } }
    },
    "/api/v1/auth/logout": {
      "post": { "summary": "Revoke all refresh tokens", "tags": ["Authentication"],
        "responses": { "204": { "description": "Logged out" } } }
    },
    "/api/v1/auth/verify-email": {
      "get": { "summary": "Verify email address", "tags": ["Authentication"],
        "parameters": [{ "name": "token", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Email verified" }, "400": { "description": "Invalid or expired token" } } }
    },
    "/api/v1/auth/password-reset": {
      "post": { "summary": "Request password reset email", "tags": ["Authentication"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetRequest" } } } },
        "responses": { "200": { "description": "Reset link sent (if email is registered)" } } }
    },
    "/api/v1/auth/password-reset/confirm": {
      "post": { "summary": "Confirm password reset", "tags": ["Authentication"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetConfirmRequest" } } } },
        "responses": { "200": { "description": "Password reset" }, "400": { "description": "Invalid token" } } }
    },
    "/api/v1/auth/mfa/verify": {
      "post": { "summary": "Verify TOTP MFA code (admin accounts)", "tags": ["Authentication"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MfaVerifyRequest" } } } },
        "responses": { "200": { "description": "MFA verified" }, "401": { "description": "Invalid code" } } }
    },
    "/api/v1/users/me": {
      "get": { "summary": "Get authenticated user info", "tags": ["Users"],
        "responses": { "200": { "description": "User account data" } } }
    },
    "/api/v1/users/me/roles": {
      "post": { "summary": "Assign a role to the authenticated user", "tags": ["Users"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignRoleRequest" } } } },
        "responses": { "200": { "description": "Role assigned" } } }
    },
    "/api/v1/athletes": {
      "post": { "summary": "Create athlete profile", "tags": ["Athletes"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAthleteProfileRequest" } } } },
        "responses": { "201": { "description": "Athlete profile created" }, "409": { "description": "Profile already exists" } } }
    },
    "/api/v1/athletes/me": {
      "get": { "summary": "Get own athlete profile", "tags": ["Athletes"],
        "responses": { "200": { "description": "Athlete profile" } } }
    },
    "/api/v1/athletes/{id}": {
      "get": { "summary": "Get athlete profile by ID", "tags": ["Athletes"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Athlete profile" }, "403": { "description": "Consent withdrawn" }, "404": { "description": "Not found" } } },
      "patch": { "summary": "Update athlete profile", "tags": ["Athletes"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAthleteProfileRequest" } } } },
        "responses": { "200": { "description": "Updated" } } }
    },
    "/api/v1/athletes/{id}/sports": {
      "post": { "summary": "Add sport to athlete profile", "tags": ["Athletes"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddSportRequest" } } } },
        "responses": { "201": { "description": "Sport added" } } },
      "get": { "summary": "List athlete sports", "tags": ["Athletes"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Sport list" } } }
    },
    "/api/v1/athletes/{id}/achievements": {
      "post": { "summary": "Add achievement to athlete profile", "tags": ["Athletes"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddAchievementRequest" } } } },
        "responses": { "201": { "description": "Achievement added" } } }
    },
    "/api/v1/athletes/{id}/development": {
      "get": { "summary": "Get athlete development timeline", "tags": ["Development"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Development timeline" } } }
    },
    "/api/v1/athletes/{id}/performance": {
      "get": { "summary": "Get athlete performance chart data", "tags": ["Development"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Performance measurements" } } }
    },
    "/api/v1/athletes/{id}/activities": {
      "post": { "summary": "Create activity draft for athlete", "tags": ["Activities"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateActivityRequest" } } } },
        "responses": { "201": { "description": "Activity draft created" } } },
      "get": { "summary": "List athlete activities", "tags": ["Activities"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Paginated activities" } } }
    },
    "/api/v1/activity-types/{id}/schema": {
      "get": { "summary": "Get published schema for activity type", "tags": ["Activity Configuration"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Published schema" } } }
    },
    "/api/v1/admin/activity-types": {
      "post": { "summary": "Create activity type", "tags": ["Admin – Activity Schema"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateActivityTypeRequest" } } } },
        "responses": { "201": { "description": "Activity type created" } } }
    },
    "/api/v1/admin/activity-templates": {
      "post": { "summary": "Create activity template with field definitions", "tags": ["Admin – Activity Schema"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateActivityTemplateRequest" } } } },
        "responses": { "201": { "description": "Template created" } } }
    },
    "/api/v1/admin/activity-schema-versions/{id}/publish": {
      "post": { "summary": "Publish an activity schema version", "tags": ["Admin – Activity Schema"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Schema version published" } } }
    },
    "/api/v1/activities/{id}": {
      "get": { "summary": "Get activity", "tags": ["Activities"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Activity" }, "404": { "description": "Not found" } } },
      "patch": { "summary": "Update activity draft", "tags": ["Activities"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateActivityRequest" } } } },
        "responses": { "200": { "description": "Updated" } } }
    },
    "/api/v1/activities/{id}/submit": {
      "post": { "summary": "Submit activity", "tags": ["Activities"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Activity submitted" } } }
    },
    "/api/v1/activities/{id}/publish": {
      "post": { "summary": "Publish activity", "tags": ["Activities"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Activity published" } } }
    },
    "/api/v1/activities/{id}/media": {
      "post": { "summary": "Initiate media upload for activity", "tags": ["Media"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InitiateUploadRequest" } } } },
        "responses": { "201": { "description": "Upload session created" } } }
    },
    "/api/v1/media/uploads": {
      "post": { "summary": "Initiate a media upload", "tags": ["Media"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InitiateUploadRequest" } } } },
        "responses": { "201": { "description": "Upload session with presigned URL" } } }
    },
    "/api/v1/media/uploads/{id}/complete": {
      "post": { "summary": "Complete a media upload", "tags": ["Media"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Upload completed, processing started" } } }
    },
    "/api/v1/media/{id}": {
      "get": { "summary": "Get media asset metadata", "tags": ["Media"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Media asset" }, "403": { "description": "Consent withdrawn" } } }
    },
    "/api/v1/media/{id}/playback": {
      "get": { "summary": "Get presigned playback URL", "tags": ["Media"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Presigned URL" }, "403": { "description": "Media restricted" } } }
    },
    "/api/v1/guardians/me/athletes": {
      "get": { "summary": "List athletes linked to the guardian", "tags": ["Guardians"],
        "responses": { "200": { "description": "Linked athletes" } } }
    },
    "/api/v1/guardian-relationships": {
      "post": { "summary": "Request a guardian relationship", "tags": ["Guardians"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuardianRelationshipRequest" } } } },
        "responses": { "201": { "description": "Relationship request created" } } },
      "get": { "summary": "List guardian relationships", "tags": ["Guardians"],
        "responses": { "200": { "description": "Relationships" } } }
    },
    "/api/v1/guardian-relationships/{id}/approve": {
      "post": { "summary": "Approve a guardian relationship request", "tags": ["Guardians"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Relationship approved" } } }
    },
    "/api/v1/guardian-relationships/{id}/revoke": {
      "post": { "summary": "Revoke a guardian relationship", "tags": ["Guardians"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Relationship revoked" } } }
    },
    "/api/v1/organizations": {
      "post": { "summary": "Register an organization", "tags": ["Organizations"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrganizationRequest" } } } },
        "responses": { "201": { "description": "Organization created" } } }
    },
    "/api/v1/organizations/{id}": {
      "get": { "summary": "Get organization", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Organization" } } },
      "patch": { "summary": "Update organization", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateOrganizationRequest" } } } },
        "responses": { "200": { "description": "Updated" } } }
    },
    "/api/v1/organizations/{id}/invitations": {
      "post": { "summary": "Invite a user to the organization", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InviteMemberRequest" } } } },
        "responses": { "201": { "description": "Invitation sent" } } }
    },
    "/api/v1/organizations/{id}/members": {
      "get": { "summary": "List organization members", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Member list" } } }
    },
    "/api/v1/organizations/{id}/athletes": {
      "get": { "summary": "List athletes affiliated with the organization", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Athlete list" } } }
    },
    "/api/v1/organizations/{id}/athlete-relationships": {
      "post": { "summary": "Request athlete affiliation with organization", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AthleteRelationshipRequest" } } } },
        "responses": { "201": { "description": "Affiliation requested" } } }
    },
    "/api/v1/organizations/{id}/scouting/workspace/activate": {
      "post": { "summary": "Activate scouting workspace for organization", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Workspace activated" } } }
    },
    "/api/v1/organizations/{id}/scouting/seats": {
      "post": { "summary": "Assign scout seats to the organization", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssignSeatsRequest" } } } },
        "responses": { "200": { "description": "Seats assigned" } } }
    },
    "/api/v1/organizations/{id}/scouting/watchlists": {
      "get": { "summary": "List organization-shared scouting watchlists", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Shared watchlists" } } }
    },
    "/api/v1/organizations/{id}/scouting/evaluations": {
      "get": { "summary": "List organization-shared evaluations", "tags": ["Organizations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Shared evaluations" } } }
    },
    "/api/v1/scouts/profile": {
      "post": { "summary": "Create scout profile", "tags": ["Scout"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateScoutProfileRequest" } } } },
        "responses": { "201": { "description": "Scout profile created" } } }
    },
    "/api/v1/scouts/me": {
      "get": { "summary": "Get own scout profile", "tags": ["Scout"],
        "responses": { "200": { "description": "Scout profile" } } }
    },
    "/api/v1/scouts/me/specializations": {
      "post": { "summary": "Add scout specialization", "tags": ["Scout"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AddSpecializationRequest" } } } },
        "responses": { "201": { "description": "Specialization added" } } },
      "get": { "summary": "List specializations", "tags": ["Scout"], "responses": { "200": { "description": "List" } } }
    },
    "/api/v1/discovery/athletes": {
      "get": { "summary": "Search athletes", "tags": ["Discovery"],
        "parameters": [
          { "name": "sport", "in": "query", "schema": { "type": "string" } },
          { "name": "country", "in": "query", "schema": { "type": "string" } },
          { "name": "position", "in": "query", "schema": { "type": "string" } },
          { "name": "ageCategory", "in": "query", "schema": { "type": "string" } },
          { "name": "verificationStatus", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } },
          { "name": "size", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Paginated results" }, "403": { "description": "Requires paid plan" } } }
    },
    "/api/v1/discovery/athletes/{id}": {
      "get": { "summary": "Get athlete discovery card", "tags": ["Discovery"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Discovery card" }, "403": { "description": "Consent withdrawn" } } }
    },
    "/api/v1/discovery/saved-searches": {
      "post": { "summary": "Save discovery search", "tags": ["Discovery"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SavedSearchRequest" } } } },
        "responses": { "201": { "description": "Saved" } } },
      "get": { "summary": "List saved searches", "tags": ["Discovery"], "responses": { "200": { "description": "List" } } }
    },
    "/api/v1/scouting/favourites": {
      "post": { "summary": "Add to favourites", "tags": ["Scouting"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FavouriteRequest" } } } },
        "responses": { "201": { "description": "Added" }, "409": { "description": "Duplicate" } } },
      "get": { "summary": "List favourites", "tags": ["Scouting"], "responses": { "200": { "description": "List" } } }
    },
    "/api/v1/scouting/favourites/{id}": {
      "delete": { "summary": "Remove from favourites", "tags": ["Scouting"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "204": { "description": "Removed" } } }
    },
    "/api/v1/scouting/watchlists": {
      "post": { "summary": "Create watchlist", "tags": ["Scouting"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateWatchlistRequest" } } } },
        "responses": { "201": { "description": "Created" } } },
      "get": { "summary": "List watchlists", "tags": ["Scouting"], "responses": { "200": { "description": "List" } } }
    },
    "/api/v1/scouting/watchlists/{id}/athletes": {
      "post": { "summary": "Add athlete to watchlist", "tags": ["Scouting"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WatchlistAthleteRequest" } } } },
        "responses": { "201": { "description": "Added" }, "409": { "description": "Duplicate" } } }
    },
    "/api/v1/scouting/follows": {
      "post": { "summary": "Follow athlete", "tags": ["Scouting"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FollowRequest" } } } },
        "responses": { "201": { "description": "Following" }, "409": { "description": "Already following" } } }
    },
    "/api/v1/scouting/evaluations": {
      "post": { "summary": "Create evaluation", "tags": ["Scouting"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateEvaluationRequest" } } } },
        "responses": { "201": { "description": "Created" }, "403": { "description": "FEATURE_NOT_AVAILABLE" } } },
      "get": { "summary": "List evaluations", "tags": ["Scouting"], "responses": { "200": { "description": "List" } } }
    },
    "/api/v1/scouting/evaluations/{id}/scores": {
      "post": { "summary": "Add scores to evaluation", "tags": ["Scouting"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EvaluationScoreRequest" } } } },
        "responses": { "201": { "description": "Scores added" } } }
    },
    "/api/v1/scouting/evaluations/{id}/complete": {
      "post": { "summary": "Complete evaluation", "tags": ["Scouting"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Completed" } } }
    },
    "/api/v1/scouting/notes": {
      "post": { "summary": "Create scouting note", "tags": ["Scouting"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScoutingNoteRequest" } } } },
        "responses": { "201": { "description": "Note created" } } }
