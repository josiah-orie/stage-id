# ============================================================
# TalentHub Production Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=talenthub
MYSQL_USER=talenthub
MYSQL_PASSWORD=change_me_db_password
MYSQL_PORT=3306

# ---- MinIO ----
MINIO_ACCESS_KEY=change_me_minio_access
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ATHLETE_BUCKET=athlete-media
MINIO_ORG_BUCKET=org-media
MINIO_PRIVATE_BUCKET=private-docs

# ---- JWT ----
# Must be at least 256 bits (32 characters) for HMAC-SHA256
JWT_SECRET=change_me_to_a_very_long_random_secret_key_at_least_32_chars
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# ---- Mail (SMTP) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=change_me_mail_password

# ---- Payments ----
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_live_change_me_paystack_secret

# ---- App ----
APP_PORT=8080
MAX_VIDEO_SIZE_BYTES=524288000

# ---- CORS ----
# Comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=https://app.example.com
